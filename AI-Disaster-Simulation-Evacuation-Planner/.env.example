PLANNER_HOST=127.0.0.1
PLANNER_PORT=8000
PLANNER_LOG_LEVEL=INFO
# Map anchor for the SYNTHETIC grid (display only; the roads are not real)
PLANNER_ORIGIN_LAT=17.3850
PLANNER_ORIGIN_LON=78.4867
# --- Session management (all optional; defaults shown) ---
PLANNER_SESSION_TTL_S=1800
PLANNER_MAX_SESSIONS=50
PLANNER_MAX_CUSTOM_SCENARIOS=20
PLANNER_ANALYTICS_CACHE_SIZE=16


# --- Data (Phase 3) ---
# Which dataset to run on. Default: the synthetic demo. After scripts/build_dataset.py:
# PLANNER_DATASET=data/processed/my_city.json

# --- Map tiles ---
# CARTO watermarks keyless tiles ("API KEY REQUIRED") since Aug 2026. Without a key the map uses OpenStreetMap.
# Free key: https://carto.com/basemaps/apikey/   (do not commit .env)
# PLANNER_CARTO_API_KEY=